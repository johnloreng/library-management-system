{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["prisma/**/*.ts", "src/**/*.ts"],
  "ts-node": {
    "transpileOnly": false,
    "files": true
  }
}
